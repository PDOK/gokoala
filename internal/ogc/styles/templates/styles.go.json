{{- /*gotype: github.com/PDOK/gokoala/internal/engine.TemplateData*/ -}}
{
  {{ if or .Config.OgcAPI.Styles .Config.OgcAPI.Maps }}
  {{ $baseUrl := .Config.BaseURL }}
  {{ $supportedSrs := .Params.SupportedProjections }}
  {{ $projections := .Params.AllProjections }}
  "links": [
    {
      "rel": "self",
      "type": "application/json",
      "title": "This document",
      "href": "{{ $baseUrl }}/styles?f=json"
    },
    {
      "rel": "alternate",
      "type": "text/html",
      "title": "This document as HTML",
      "href": "{{ $baseUrl }}/styles?f=html"
    }
  ],
  {{ if .Params.HasTiles }}
  "default": "{{ .Config.OgcAPI.Styles.Default }}",
  {{ end }}
  "styles": [
    {{ $hasStyle := false }}
    {{ if .Params.HasTiles }}
    {{ range $st_index, $style := .Config.OgcAPI.Styles.SupportedStyles }}
    {{ range $srs_index, $srs := $supportedSrs }}
    {{ if $hasStyle }},{{ end }}{{ $hasStyle = true }}
    {
      "id": "{{ $style.ID }}__{{ get $projections (index $srs).Srs | lower }}",
      "title": "{{ $style.Title }} ({{ get $projections (index $srs).Srs }})",
      "links": [
        {
          "rel": "describedby",
          "title": "Style Metadata for {{ $style.ID }}",
          "href": "{{ $baseUrl }}/styles/{{ $style.ID }}__{{ get $projections (index $srs).Srs | lower }}/metadata"
        }
        {{ if $style.Legend }}
        ,{
          "rel": "http://www.opengis.net/def/rel/ogc/1.0/legend",
          "type": "image/png",
          "title": "Style Legend for {{ $style.ID }}",
          "href": "{{ $baseUrl }}/styles/{{ $style.ID }}__{{ get $projections (index $srs).Srs | lower }}/legend"
        }
        {{ end }}
        {{ if $style.Formats }},{{ end }}
        {{ range $sh_index, $stylesheet := $style.Formats }}
        {{ if $sh_index }},{{ end }}
        {
          "rel": "stylesheet",
          {{ if eq $stylesheet.Format "mapbox" }}
          "title": "Mapbox Style",
          "type": "application/vnd.mapbox.style+json",
          {{ else if eq $stylesheet.Format "sld10" }}
          "title": "OpenGIS Styled Layer Descriptor 1.0 Style",
          "type": "application/vnd.ogc.sld+xml;version=1.0",
          {{ end }}
          {{/* Add support for more style formats here */}}
          "href": "{{ $baseUrl }}/styles/{{ $style.ID }}__{{ get $projections (index $srs).Srs | lower }}?f={{ $stylesheet.Format }}"
        }
        {{ end }}
      ]
    }
    {{ end }}
    {{ end }}
    {{ end }}
    {{ if .Params.HasMaps }}
    {{ range $coll := .Config.OgcAPI.Maps.Collections }}
    {{ range $style := $coll.GetStyles }}
    {{ if $hasStyle }},{{ end }}{{ $hasStyle = true }}
    {
      "id": {{ mustToRawJson ($.Config.MapsStyleID $coll.ID $style.ID) }},
      "title": {{ mustToRawJson $style.Title }},
      "links": [
        {
          "rel": "https://www.opengis.net/def/rel/ogc/1.0/map",
          "type": "image/png",
          "title": {{ mustToRawJson (printf "%s as PNG" $style.Title) }},
          "href": "{{ $baseUrl }}/collections/{{ $coll.ID }}/styles/{{ $style.ID }}/map?f=png"
        },
        {
          "rel": "https://www.opengis.net/def/rel/ogc/1.0/map",
          "type": "image/jpeg",
          "title": {{ mustToRawJson (printf "%s as JPEG" $style.Title) }},
          "href": "{{ $baseUrl }}/collections/{{ $coll.ID }}/styles/{{ $style.ID }}/map?f=jpeg"
        },
        {
          "rel": "https://www.opengis.net/def/rel/ogc/1.0/map",
          "type": "text/html",
          "title": {{ mustToRawJson (printf "%s as HTML" $style.Title) }},
          "href": "{{ $baseUrl }}/collections/{{ $coll.ID }}/styles/{{ $style.ID }}/map?f=html"
        },
	{
          "rel": "https://www.opengis.net/def/rel/ogc/1.0/legend",
	  "type": {{ mustToRawJson $style.LegendMediaType }},
	  "title": "Legend for {{ $style.Title }}",
	  "href": "{{ $baseUrl }}/collections/{{ $coll.ID }}/styles/{{ $style.ID }}/legend"
	}
      ]
    }
    {{ end }}
    {{ end }}
    {{ end }}
  ]
  {{ end }}
}
