{{- /*gotype: github.com/PDOK/gokoala/internal/engine.TemplateData*/ -}}
{{ $baseUrl := .Config.BaseURL }}
{{ $collectionId := .Params.Collection.ID }}
{
  "links": [
    {
      "rel": "self",
      "type": "application/json",
      "title": "This document",
      "href": "{{ $baseUrl }}/collections/{{ $collectionId }}/styles?f=json"
    },
    {
      "rel": "alternate",
      "type": "text/html",
      "title": "This document as HTML",
      "href": "{{ $baseUrl }}/collections/{{ $collectionId }}/styles?f=html"
    }
  ],
  {{ if .Params.Styles }}
  "default": {{ mustToRawJson (index .Params.Styles 0).ID }},
  {{ end }}
  "styles": [
    {{ range $index, $style := .Params.Styles }}
    {{ if $index }},{{ end }}
    {
      "id": {{ mustToRawJson $style.ID }},
      "title": {{ mustToRawJson $style.Title }},
      "links": [
        {
          "rel": "https://www.opengis.net/def/rel/ogc/1.0/map",
          "type": "image/png",
          "title": {{ mustToRawJson (printf "%s as PNG" $style.Title) }},
          "href": "{{ $baseUrl }}/collections/{{ $collectionId }}/styles/{{ $style.ID }}/map?f=png"
        },
        {
          "rel": "https://www.opengis.net/def/rel/ogc/1.0/map",
          "type": "image/jpeg",
          "title": {{ mustToRawJson (printf "%s as JPEG" $style.Title) }},
          "href": "{{ $baseUrl }}/collections/{{ $collectionId }}/styles/{{ $style.ID }}/map?f=jpeg"
        },
        {
          "rel": "https://www.opengis.net/def/rel/ogc/1.0/map",
          "type": "text/html",
          "title": {{ mustToRawJson (printf "%s as HTML" $style.Title) }},
          "href": "{{ $baseUrl }}/collections/{{ $collectionId }}/styles/{{ $style.ID }}/map?f=html"
        },
	{
          "rel": "https://www.opengis.net/def/rel/ogc/1.0/legend",
	  "type": {{ mustToRawJson $style.LegendMediaType }},
	  "title": "Legend for {{ $style.Title }}",
	  "href": "{{ $baseUrl }}/collections/{{ $collectionId }}/styles/{{ $style.ID }}/legend"
	}
      ]
    }
    {{ end }}
  ]
}
