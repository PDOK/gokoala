{
  "name": "view-component",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run format && npm run lint && ng build --configuration production --verbose --output-hashing none",
    "watch": "ng build --watch --configuration development",
    "test": "npx cypress info && npx cypress run --component",
    "ghpage": "angular-cli-ghpages --dir=dist/view-component/browser",
    "lint": "ng lint",
    "cypress": "export CYPRESS_REMOTE_DEBUGGING_PORT=9222; npx cypress open",
    "format": "npx prettier --write .",
    "upgrade": "ng update @angular/cli @angular/core angular-cli-ghpages @angular/build @angular-devkit/build-angular @angular/elements @angular-eslint/eslint-plugin @angular-eslint/eslint-plugin-template @angular-eslint/schematics --force && npm update && npm audit fix --force"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/elements": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@popperjs/core": "2.11.8",
    "bootstrap": "5.2.3",
    "bootstrap-icons": "^1.13.1",
    "ngx-logger": "^5.0.12",
    "ol": "^10.9.0",
    "ol-mapbox-style": "^13.4.1",
    "proj4": "^2.20.9",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.3",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.3",
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "^22.2.3",
    "@angular/cli": "~22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "^9.39.5",
    "@smarttools/eslint-plugin-rxjs": "^1.0.22",
    "@types/node": "^24.19.2",
    "@types/bootstrap": "5.2.10",
    "@types/jest": "^30.0.0",
    "@types/proj4": "2.5.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "angular-cli-ghpages": "^3.1.0",
    "angular-eslint": "^22.6.0",
    "axe-core": "^4.14.0",
    "cypress": "^16.1.0",
    "cypress-network-idle": "^2.0.1",
    "cypress-vite": "^1.10.2",
    "esbuild-visualizer": "^0.6.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "istanbul-lib-instrument": "^6.0.3",
    "prettier": "3.7.4",
    "prettier-eslint": "^17.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "webpack-bundle-analyzer": "^5.3.1"
  },
  "overrides": {
    "webpack-dev-server": "^5.2.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "cypress@16.1.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
